<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:padding="24dp"
    android:background="@color/background">

    <!-- Título Institucional -->
    <TextView
        android:id="@+id/tvTitulo"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="ELECCIONES DE ALCALDÍA"
        android:textSize="22sp"
        android:textStyle="bold"
        android:textColor="@color/text_primary"
        android:gravity="center"
        android:layout_marginBottom="4dp" />

    <TextView
        android:id="@+id/tvSubtitulo"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="Módulo de Votación • Validación de Elector"
        android:textSize="14sp"
        android:textColor="@color/text_secondary"
        android:gravity="center"
        android:layout_marginBottom="32dp" />

    <!-- HU-01: Campo para Documento -->
    <TextView
        android:id="@+id/lblDocumento"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="Documento de Identidad:"
        android:textStyle="bold"
        android:textColor="@color/text_primary"
        android:layout_marginBottom="6dp" />

    <EditText
        android:id="@+id/etDocumento"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:hint="Ingrese número de cédula o T.I."
        android:inputType="number"
        android:minHeight="48dp"
        android:layout_marginBottom="20dp" />

    <!-- HU-01 & HU-02: Campo para Edad -->
    <TextView
        android:id="@+id/lblEdad"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="Edad del Elector:"
        android:textStyle="bold"
        android:textColor="@color/text_primary"
        android:layout_marginBottom="6dp" />

    <EditText
        android:id="@+id/etEdad"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:hint="Ingrese edad (debe ser mayor a 18)"
        android:inputType="number"
        android:minHeight="48dp"
        android:layout_marginBottom="32dp" />

    <!-- Botón de Validación y Acceso al Voto -->
    <Button
        android:id="@+id/btnValidar"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="Validar y Proceder a Votar"
        android:textAllCaps="false"
        android:textSize="16sp"
        android:minHeight="54dp"
        android:layout_marginBottom="16dp" />

    <View
        android:layout_width="match_parent"
        android:layout_height="1dp"
        android:background="#E2E8F0"
        android:layout_marginTop="16dp"
        android:layout_marginBottom="24dp" />

    <!-- Acceso al Módulo Administrador -->
    <Button
        android:id="@+id/btnIrAdmin"
        style="@style/Widget.MaterialComponents.Button.OutlinedButton"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="Acceso Módulo Administrador"
        android:textAllCaps="false"
        android:minHeight="48dp" />

</LinearLayout>
